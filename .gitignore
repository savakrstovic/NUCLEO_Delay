# STM32CubeIDE build output
Debug/
Release/
*.o
*.d
*.su
*.cyclo
*.elf
*.bin
*.hex
*.map
*.list

# Eclipse / IDE local state (keep .project, .cproject, .mxproject, .ioc)
# .settings/* rather than .settings/ - git will not descend into an excluded
# directory, so the negation below only works with the glob form.
.metadata/
.settings/*
!.settings/org.eclipse.core.resources.prefs
*.launch

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
